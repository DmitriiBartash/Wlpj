<div class="panel">
	@if (Model is not null)
	{
		@if (@ViewBag.ID == null)
		{
			<p id="countrySelectedID" hidden>@Model.ID</p>
		}
		else
		{
			<p id="countrySelectedID" hidden>@ViewBag.ID</p>
		}
		<div class="name_country">
			<p>Название: </p>
		</div>
		<div class="prices">
			<p>Цена в $: @Model?.PriceUsd</p>
			<p>Цена в €: @Model?.PriceEuro</p>
		</div>

		<div class="TAGS">
			@foreach (var tag in @Model.Tags)
			{
				<p><img src="~/content/tags/@tag?.icon">@tag?.tag</p>
			}
		</div>

		<button class="tag_button" onclick="openPopUp(this)">Редактировать</button>

		<button class="tag_button" onclick="deleteThis(this)">Удалить</button>
	}
	else
	{
		<h1>aaa</h1>
		<h1>aaa</h1>
		<h1>aaa</h1>
		<h1>aaa</h1>
		<h1>aaa</h1>
		<h1>aaa</h1>
		<h1>aaa</h1>
		<h1>aaa</h1>
		<h1>aaa</h1>
	}
</div>
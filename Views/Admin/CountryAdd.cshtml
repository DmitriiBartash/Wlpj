@{
	ViewData["Title"] = "CountryAdd";
	Layout = "~/Views/Shared/_AdminLayuot.cshtml";
}

<h1>Countries</h1>

<div id="names">
	<input type="text" id="ruName" required>
	<label for="ruName">Название страны на русском</label><br />
	<input type="text" id="enName" required>
	<label for="enName">Name of the country in english</label><br />
	<input type="text" id="roName" required>
	<label for="roName">Nume tarii in romana</label><br /><br /><br />
</div>

<div id="imagesToAdd">
	<div class="stretched-button">
		<input type="file" id="hidden-file-input" accept="image/*" hidden>
		<button type="button" onclick="asyncGet()">+</button>
	</div>
</div>

<br />
<div id="tags">
	<input type="checkbox" id="tag1" name="tag1" value="Перелёт">
	<label for="tag1"> Перелёт</label><br>
	<input type="checkbox" id="tag2" name="tag2" value="Трансфер">
	<label for="tag2"> Трансфер</label><br>
	<input type="checkbox" id="tag3" name="tag3" value="Проживание">
	<label for="tag3"> Проживание</label><br>
	<input type="checkbox" id="tag4" name="tag4" value="Питание согласно концепции отеля">
	<label for="tag4"> Питание согласно концепции отеля</label><br>
	<input type="checkbox" id="tag5" name="tag5" value="Медицинская страховка">
	<label for="tag5"> Медицинская страховка</label><br>

	<button onclick="sendCountryData()">Добавить страну</button>
</div>


<div>
	<a asp-action="Index">Back to List</a>
</div>

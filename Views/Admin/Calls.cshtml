@model IEnumerable<LandingPage.Models.CallBackModel>

@{
	ViewData["Title"] = "Calls";
	Layout = "~/Views/Admin/_AdminLayuot.cshtml";
}

<style>
	* {
		margin: 0;
	}

	body {
		cursor: default;
	}

	header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-bottom: 2px solid black;
		padding: 1%;
		margin: 0px;
		background-color: #2c3968;
		color: white;
	}

		header a {
			color: white;
			text-decoration: none;
			font-size: 1rem;
			transition: ease .3s;
		}

			header a:hover {
				color: red;
			}

	h3 {
		padding: 1%;
	}

	.table {
		width: 100%;
		border: 5px solid grey;
		border-collapse: collapse;
		background: linear-gradient(to top left, powderblue, pink);
	}

	.table th {
		border: 5px solid grey;
		padding: 0.5%;
	}

	.table td {
		border: 5px solid grey;
		padding: 0.5%;
	}

	.delete_call {
		display: flex;
		justify-content: center;
	}

	.delete_call:hover {
		color: red;
	}

</style>

<header>
	<h1>Admin calls</h1>
	<div class="logout-container">
		<a href="~/Login/Logout">Log out</a> |
		<a asp-controller="Home" asp-action="Index">Home</a> |
		<a href="#">Back</a>
	</div>
</header>

<body>

	<h3>Люди оставившие заявку:</h3>

	<table class="table">
		<thead>
			<tr>
				<th>
					<h3>Имя Фамилия</h3>
				</th>
				<th>
					<h3>Номер телефона</h3>
				</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<td>
						<h1>@Html.DisplayFor(modelItem => item.NameSurname)</h1>
					</td>
					<td>
						<h1>@Html.DisplayFor(modelItem => item.PhoneNumber)</h1>
					</td>
					<td>
						<a class="delete_call" asp-action="DeleteCall" asp-route-id="@item.ID">Delete</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
</body>


@model IEnumerable<LandingPage.Models.CallBackModel>

@{
	ViewData["Title"] = "Calls";
	Layout = "~/Views/Admin/_AdminLayuot.cshtml";
}

<h1>Звонки</h1>

<table class="table">
	<thead>
		<tr>
			<th>
				<h1>Имя Фамилия</h1>
			</th>
			<th>
				<h1>Номер телефона</h1>
			</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>
					<h1>@Html.DisplayFor(modelItem => item.NameSurname)</h1>
				</td>
				<td>
					<h1>@Html.DisplayFor(modelItem => item.PhoneNumber)</h1>
				</td>
				<td>
					<a asp-action="DeleteCall" asp-route-id="@item.ID">Delete</a>
				</td>
			</tr>
		}
	</tbody>
</table>



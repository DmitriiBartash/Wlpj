@model LandingPage.Models.ReviewModel

@{
	Layout = "~/Views/Admin/_AdminLayuot.cshtml";
}

<style>
	* {
		margin: 0;
	}

	body {
		cursor: default;
	}

	header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-bottom: 2px solid black;
		padding: 1%;
		margin: 0px;
		background-color: #2c3968;
		color: white;
	}

		header a {
			color: white;
			text-decoration: none;
			font-size: 1rem;
			transition: ease .3s;
		}

			header a:hover {
				color: red;
			}

	h3 {
		padding: 1%;
	}

	.control-label {
		font-size: 1.2vw;
	}

	.form-group {
		display: flex;
		flex-direction: column;
		padding: 0.5%;
	}

	.form-control {
		width: 80vw;
	}

	.btn {
		width: 10vw;
		transition: ease .3s;
		cursor: pointer;
	}

		.btn:hover {
			background-color: #55e755cc;
		}
</style>

<header>
	<h1>Adding a review</h1>
	<div class="logout-container">
		<a href="~/Login/Logout">Log out</a> |
		<a asp-controller="Home" asp-action="Index">Home</a> |
		<a asp-controller="Admin" asp-action="Reviews">Back</a>
	</div>
</header>

<body>
	<h3>Напишите ваш отзыв</h3>
	<hr />
	<div class="row">
		<div class="col-md-4">
			<form asp-action="ReviewAdd" method="post">
				<div asp-validation-summary="ModelOnly" class="text-danger"></div>
				<div class="form-group">
					<label asp-for="Person" class="control-label"></label>
					<input asp-for="Person" class="form-control" />
					<span asp-validation-for="Person" class="text-danger"></span>
				</div>
				<div class="form-group">
					<label asp-for="Review" class="control-label"></label>
					<input asp-for="Review" class="form-control" />
					<span asp-validation-for="Review" class="text-danger"></span>
				</div>
				<div class="form-group">
					<input type="submit" value="Create" class="btn btn-primary" />
				</div>
			</form>
		</div>
	</div>

</body>
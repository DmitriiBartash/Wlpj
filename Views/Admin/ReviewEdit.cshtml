@model LandingPage.Models.ReviewModel

@{
	Layout = "~/Views/Shared/_AdminLayuot.cshtml";
}

<style>
	header {
		display: flex;
		justify-content: space-between;
		border-bottom: 2px solid black;
		padding: 1%;
		margin: -0.6%;
		background-color: #2c3968;
		color: white;
	}

		header a {
			color: white;
			text-decoration: none;
			font-size: 1rem;
		}

			header a:hover {
				color: red;
			}

	.body {
		font-family: 'Lucida Sans', 'Lucida Sans Regular', 'Lucida Grande', 'Lucida Sans Unicode', Geneva, Verdana, sans-serif;
	}


	.back_to_list:hover {
		color: red;
	}

	.form-group {
		padding: 1%;
	}

	.btn:hover {
		background-color: #55e755cc;
	}

</style>

<header>
	<a href="#">Admin ReviesEdit</a>

	<div class="logout-container">
		<a href="#">Log out</a> |
		<a href="../Home/Index">Home</a>
	</div>
</header>

<body>

	<h1>ReviewEdit</h1>

	<h4>ReviewModel</h4>
	<hr />
	<div class="row">
		<div class="col-md-4">
			<form asp-action="ReviewEdit" method="post">
				<div asp-validation-summary="ModelOnly" class="text-danger"></div>
				<input type="hidden" asp-for="Id" />
				<div class="form-group">
					<label asp-for="Person" class="control-label"></label>
					<input asp-for="Person" class="form-control" />
					<span asp-validation-for="Person" class="text-danger"></span>
				</div>
				<div class="form-group">
					<label asp-for="Review" class="control-label"></label>
					<input asp-for="Review" class="form-control" />
					<span asp-validation-for="Review" class="text-danger"></span>
				</div>
				<div class="form-group">
					<input type="submit" value="Save" class="btn btn-primary" />
				</div>
			</form>
		</div>
	</div>

	<div>
		<a class="back_to_list" asp-action="Index">Back to List</a>
	</div>

</body>


@model IEnumerable<LandingPage.Models.ReviewModel>

@{
	ViewData["Title"] = "Reviews";
	Layout = "~/Views/Admin/_AdminLayuot.cshtml";
}

<style>
	header {
		display: flex;
		justify-content: space-between;
		border-bottom: 2px solid black;
		padding: 1%;
		margin: -0.6%;
		background-color: #2c3968;
		color: white;
	}

		header a {
			color: white;
			text-decoration: none;
			font-size: 1rem;
		}

			header a:hover {
				color: red;
			}

	.body {
		font-family: 'Lucida Sans', 'Lucida Sans Regular', 'Lucida Grande', 'Lucida Sans Unicode', Geneva, Verdana, sans-serif;
	}

	.addendum:hover,
	.edit:hover,
	.delete:hover {
		color: red;
	}

	.table {
		width: 100%;
		border: 5px solid grey;
		border-collapse: collapse;
		background: linear-gradient(to top left, powderblue, pink);
	}

	}

	.table th {
		border: 5px solid grey;
		padding: 0.5%;
	}

	.table td {
		border: 5px solid grey;
		padding: 0.5%;
	}
</style>

<header>
	<a href="#">Admin Revies</a>

	<div class="logout-container">
		<a href="#">Log out</a> |
		<a href="../Home/Index">Home</a>
	</div>
</header>

<body>

	<h1>Reviews</h1>

	<h3>
		<a class="addendum" asp-action="ReviewAdd">Create New</a>
	</h3>

	<table class="table">
		<thead>
			<tr>
				<th>
					@Html.DisplayNameFor(model => model.Person)
				</th>
				<th>
					@Html.DisplayNameFor(model => model.Review)
				</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<td>
						@Html.DisplayFor(modelItem => item.Person)
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.Review)
					</td>
					<td>
						<a class="edit" asp-action="ReviewEdit" asp-route-id="@item.Id">Edit</a> |
						<a class="delete" asp-action="ReviewDelete" asp-route-id="@item.Id">Delete</a>
					</td>
				</tr>
			}
		</tbody>
	</table>

</body>
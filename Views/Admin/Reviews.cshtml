@model IEnumerable<LandingPage.Models.ReviewModel>

@{
	ViewData["Title"] = "Reviews";
	Layout = "~/Views/Admin/_AdminLayuot.cshtml";
}

<style>
	* {
		margin: 0;
	}

	body {
		cursor: default;
	}

	header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-bottom: 2px solid black;
		padding: 1%;
		margin: 0px;
		background-color: #2c3968;
		color: white;
	}

		header a {
			color: white;
			text-decoration: none;
			font-size: 1rem;
			transition: ease .3s;
		}

			header a:hover {
				color: red;
			}

	h3 {
		padding: 1%;
	}

	.addendum {
		display: block;
		width: 30%;
		border: none;
		outline: none;
		background-color: #00FF00;
		color: #fff;
		font-size: 1.8vw;
		border-radius: 60px;
		text-align: center;
		text-decoration: none;
		box-shadow: 0 6px 20px -5px rgba(0, 0, 0, 0.4);
		position: relative;
		overflow: hidden;
		cursor: pointer;
		transition: 0.5s ease-in;
	}

		.addendum:hover {
			color: red;
			background-color: yellow;
		}

	.edit, .delete {
		transition: ease .3s;
	}

		.edit:hover,
		.delete:hover {
			color: red;
		}

	.table {
		width: 100%;
		border: 5px solid grey;
		border-collapse: collapse;
		background: linear-gradient(to top left, powderblue, pink);
	}

		.table th {
			border: 5px solid grey;
		}

		.table td {
			border: 5px solid grey;
			padding: 0.5%;
		}
</style>

<header>
	<h1>Admin reviews</h1>
	<div class="logout-container">
		<a href="~/Login/Logout">Log out</a> |
		<a asp-controller="Home" asp-action="Index">Home</a> |
		<a asp-controller="Admin" asp-action="Index">Back</a>
	</div>
</header>

<body>
	<h3>
		<a class="addendum" asp-action="ReviewAdd">Напишите новый отзыв</a>
	</h3>

	<table class="table">
		<thead>
			<tr>
				<th>
					@Html.DisplayNameFor(model => model.Person)
				</th>
				<th>
					@Html.DisplayNameFor(model => model.Review)
				</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<td>
						@Html.DisplayFor(modelItem => item.Person)
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.Review)
					</td>
					<td width="8%">
						<a class="edit" asp-action="ReviewEdit" asp-route-id="@item.Id">Edit</a> |
						<a class="delete" asp-action="ReviewDelete" asp-route-id="@item.Id">Delete</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
</body>
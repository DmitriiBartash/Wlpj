@model IEnumerable<LandingPage.Models.ReviewModel>

@{
	ViewData["Title"] = "Reviews";
	Layout = "~/Views/Shared/_AdminLayuot.cshtml";
}

<h1>Reviews</h1>

<p>
	<a asp-action="ReviewAdd">Create New</a>
</p>
<table class="table">
	<thead>
		<tr>
			<th>
				@Html.DisplayNameFor(model => model.Person)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Review)
			</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>
					@Html.DisplayFor(modelItem => item.Person)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Review)
				</td>
				<td>
					<a asp-action="ReviewEdit" asp-route-id="@item.Id">Edit</a> |
					<a asp-action="ReviewDelete" asp-route-id="@item.Id">Delete</a>
				</td>
			</tr>
		}
	</tbody>
</table>

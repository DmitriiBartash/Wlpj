<div class="panel">
	@if (Model is not null)
	{
		@if (@ViewBag.ID == null)
		{
			<p id="countrySelectedID" hidden>@Model.ID</p>
		}
		else
		{
			<p id="countrySelectedID" hidden>@ViewBag.ID</p>
		}
		<div class="name_country">
			<p>Название: </p>
		</div>
		<div class="prices">
			<p>Цена: @Model?.Price</p>
			<p>Валюта @Model?.Currency</p>
		</div>

		<div class="TAGS">
			@foreach (var tag in @Model.Tags)
			{
				<p><img src="~/content/tags/@tag?.icon">@tag?.tag</p>
			}
		</div>

		<div class="panel_tag_button">
			<button class="tag_button" onclick="openPopUp(this)">Редактировать страну</button>

			<button class="tag_button" onclick="deleteCountry(this)">Удалить страну</button>
		</div>
	}
	else
	{
		<h1>aaa</h1>
		<h1>aaa</h1>
		<h1>aaa</h1>
		<h1>aaa</h1>
		<h1>aaa</h1>
		<h1>aaa</h1>
		<h1>aaa</h1>
		<h1>aaa</h1>
		<h1>aaa</h1>
	}
</div>
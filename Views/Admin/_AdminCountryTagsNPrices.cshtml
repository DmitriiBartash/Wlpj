@{
	string[] CNames = { "", "", "" };
	bool isFilled = false;
	if (Model is not null)
	{
		if (Model.CountryName != null)
		{
			if (Model.CountryName != "")
			{
				CNames = Model.CountryName.Split("|");
				if (Model.CountryName.Split("|").Length > 1)
				{
					isFilled = true;
				}
			}
		}
	}
}

<div class="panel">
	@if (Model is not null)
	{
		@if (@ViewBag.ID == null)
		{
			<p id="countrySelectedID" hidden>@Model.ID</p>
		}
		else
		{
			<p id="countrySelectedID" hidden>@ViewBag.ID</p>
		}
		<div class="name_country">
			<p>Название страны: </p>
			@if (isFilled)
			{
				<div>Ru: @CNames[0]</div>
				<div>En: @CNames[1]</div>
				<div>Ro: @CNames[2]</div>
			}
		</div>
		<div class="prices">
			<p>Цена: @Model?.Price</p>
			<p>Валюта @Model?.Currency</p>
		</div>

		<div class="TAGS">
			@foreach (var tag in @Model.Tags)
			{
				<p><img src="~/content/tags/@tag?.icon">@tag?.tag</p>
			}
		</div>

		<div class="panel_tag_button">
			<button class="tag_button" onclick="openPopUp(this)">Редактировать страну</button>
			<button class="tag_button" onclick="deleteCountry(this)">Удалить страну</button>
		</div>
	}
</div>
@using LandingPage.Models;
@{
	string[] Names = { "", "", "" };
	if (Model is not null)
		Names = Model.Name.Split("|");
}

<input type="hidden" id="modelCurrency" value="@Model?.Currency">

<div class="popup-wrapper">
	<p id="countrySelected" hidden>@ViewBag.ID</p>
	<div class="popup-grid">
		<form action="SubmitPoster" method="post">
			<fieldset>
				<legend id="popUPName"></legend>
				<div class="country-input">
					<div class="validationDiv">
						<input type="text" placeholder="RU name" value="@Names[0]">
						<p class="text-danger"></p>
					</div>
					<div class="validationDiv">
						<input type="text" placeholder="ENG name" value="@Names[1]">
						<p class="text-danger"></p>
					</div>
					<div class="validationDiv">
						<input type="text" placeholder="RO name" value="@Names[2]">
						<p class="text-danger"></p>
					</div>
				</div>
			</fieldset>

			<fieldset>
				<legend>Выберите тэги</legend>
				<div class="form__group">
					<input type="checkbox" id="fly" checked="@Model?.ifTagsPresent[0]">
					<label>Перелёт</label>
				</div>
				<div class="form__group">
					<input type="checkbox" id="transfer" checked="@Model?.ifTagsPresent[1]">
					<label>Трансфер</label>
				</div>
				<div class="form__group">
					<input type="checkbox" id="accommodation" checked="@Model?.ifTagsPresent[2]">
					<label>Проживание</label>
				</div>
				<div class="form__group">
					<input type="checkbox" id="nutrition" checked="@Model?.ifTagsPresent[3]">
					<label>Питание согласно концепции отеля</label>
				</div>
				<div class="form__group">
					<input type="checkbox" id="insurance" checked="@Model?.ifTagsPresent[4]">
					<label>Медицинская страховка</label>
				</div>
				<p id="tagsErr" class="text-danger"></p>
			</fieldset>

			<fieldset>
				<legend>Цена начинается от</legend>
				<div class="price-input" style="display: flex;flex-direction: row;">
					<input type="text" placeholder="Цена" maxlength="5" value="@Model?.Price">
					<select name="currencies" id="currency" value="@Model?.Currency">
						<option value="MDL">MDL</option>
						<option value="USD">USD</option>
						<option value="EUR">EUR</option>
					</select>
				</div>
				<p class="text-danger"></p>
			</fieldset>

			<fieldset>
				<div onclick="submit()" class="submit1" style="margin-right:0px;">V</div>
				<div onclick="reject()" class="reject1" style="margin-right:0px;">Х</div>
			</fieldset>
		</form>
	</div>
</div>
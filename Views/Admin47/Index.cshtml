@{
	Layout = "~/Views/Admin47/_AdminLayuot.cshtml";
}


<style>

	* {
		margin: 0;
	}

	body {
		width: 100vw;
		height: 95vh;
		background-color: #f1f2e5;
		cursor: default;
	}

	.listOptions {
		padding: 5%;
		padding-bottom: 0px;
		display: flex;
		height: calc(95vh - 2 * 100px);
		gap: 5%;
	}

	.options {
		width: 100%;
	}

	.countryOptions,
	.callsOptions,
	.reviewOptions {
		display: flex;
		justify-content: center;
		align-items: center;
		border-radius: 50px;
		color: black;
		text-decoration: none;
	}


		.countryOptions:hover {
			-webkit-transform: scale(0.7);
			box-shadow: 40px 40px 70px #2f6bedc7;
			color: white;
		}

		.callsOptions:hover {
			-webkit-transform: scale(0.7);
			box-shadow: 40px 40px 70px #f31414a3;
			color: white;
		}

		.reviewOptions:hover {
			-webkit-transform: scale(0.7);
			box-shadow: 40px 40px 70px #e9d744e6;
			color: white;
		}

	.countryOptions {
		background-color: #1547b4ed; /* #72D3D3 */
		font-size: 3rem;
		-webkit-transition: all 0.3s ease;
	}

	.reviewOptions {
		background-color: #f6ce2c; /* #FFF28A */
		font-size: 3rem;
		-webkit-transition: all 0.3s ease;
	}

	.callsOptions {
		background-color: #c90f0fdb; /*  #DD78D */
		font-size: 3rem;
		-webkit-transition: all 0.3s ease;
	}

	header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-bottom: 2px solid black;
		padding: 1%;
		margin: 0px;
		background-color: #2c3968;
		color: white;
	}

		header a {
			color: white;
			text-decoration: none;
			font-size: 1rem;
			transition: ease .3s;
		}

			header a:hover {
				color: red;
			}

</style>

<header>
	<h1>Admin menu</h1>

	<div class="logout-container">
		<a href="~/Login/Logout">Log out |</a>
		<a href="~/Home/Index">Home</a>
	</div>
</header>

<div class="listOptions">
	<a class="countryOptions options" asp-controller="Admin47" asp-action="Countries"><p>Страны</p></a>
	<a class="reviewOptions options" asp-controller="Admin47" asp-action="Reviews"><p>Отзывы</p></a>
	<a class="callsOptions options" asp-controller="Admin47" asp-action="Calls"><p>Звонки</p></a>
</div>
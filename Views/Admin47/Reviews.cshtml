@model IEnumerable<LandingPage.Models.ReviewModel>

@{
	ViewData["Title"] = "Reviews";
	Layout = "~/Views/Admin47/_AdminLayuot.cshtml";
}

<style>
	* {
		margin: 0;
	}

	body {
		cursor: default;
	}

	header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-bottom: 2px solid black;
		padding: 1%;
		margin: 0px;
		background-color: #2c3968;
		color: white;
	}

		header a {
			color: white;
			text-decoration: none;
			font-size: 1rem;
			transition: ease .3s;
		}

			header a:hover {
				color: red;
			}

	h3 {
		padding: 1%;
	}

	.addendum {
		display: block;
		width: 30%;
		border: none;
		outline: none;
		background-color: #00FF00;
		color: #fff;
		font-size: 1.8vw;
		border-radius: 60px;
		text-align: center;
		text-decoration: none;
		box-shadow: 0 6px 20px -5px rgba(0, 0, 0, 0.4);
		position: relative;
		overflow: hidden;
		cursor: pointer;
		transition: 0.5s ease-in;
	}

		.addendum:hover {
			color: red;
			background-color: yellow;
		}

	.reviewsGrid {
		display: flex;
		gap: 1rem;
		flex-direction: column;
	}

		.reviewsGrid p {
			word-wrap: break-word;
		}

	.reviewsRow {
		margin: 1rem;
		padding: 1rem;
		border: 3px solid skyblue;
		border-radius: 1rem;
		display: grid;
		grid-template-columns: 10% 85% 5%;
		align-items: center;
	}

	.reviewAuthor {
		height: 100%;
		border-right: 1px dashed red;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.reviewTxt {
		margin: .5rem;
	}

		.reviewTxt p {
			word-wrap: break-word;
		}

	.reviewBtns {
		height: 100%;
		display: flex;
		border-left: 1px dashed red;
		flex-direction: column;
		justify-content: center;
		align-items: center;
	}

	.reviewsGrid {
		font-size: 1.4rem;
	}
</style>

<header>
	<h1>Admin reviews</h1>
	<div class="logout-container">
		<a href="~/Login/Logout">Log out</a> |
		<a asp-controller="Home" asp-action="Index">Home</a> |
		<a asp-controller="Admin47" asp-action="Index">Back</a>
	</div>
</header>

<body>
	<h3>
		<a class="addendum" asp-action="ReviewAdd">Напишите новый отзыв</a>
	</h3>

	<div class="reviewsGrid">
		<div class="reviewsRow">
			<div class="reviewAuthor">
				<p>
					@Html.DisplayNameFor(model => model.Person)
				</p>
			</div>
			<div class="reviewAuthor">
				<p>
					@Html.DisplayNameFor(model => model.Review)
				</p>
			</div>
			<p></p>
		</div>

		@foreach (var item in Model)
		{
			<div class="reviewsRow">
				<div class="reviewAuthor">
					<p>
						@Html.DisplayFor(modelItem => item.Person)
					</p>
				</div>
				<div class="reviewTxt">
					<p>
						@Html.DisplayFor(modelItem => item.Review)
					</p>
				</div>
				<div class="reviewBtns">
					<a class="edit" asp-action="ReviewEdit" asp-route-id="@item.Id">Edit</a>
					<a class="delete" asp-action="ReviewDelete" asp-route-id="@item.Id">Delete</a>
				</div>
			</div>
		}
	</div>
</body>
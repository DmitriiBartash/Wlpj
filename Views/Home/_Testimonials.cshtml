		<div style="background-color:blue;width:100px;height:500px;"></div>
		<div style="background-color:green;width:100px;height:500px;"></div>

		<div style="background-color:purple;width:100px;height:500px;"></div>
		<div style="background-color:white;width:100px;height:500px;"></div>
		<div style="background-color:bisque;width:100px;height:500px;"></div> *@

		@* <div>your content</div>
		<div>your content</div>
		<div>your content</div>

		<div>your content</div>
		<div>your content</div>
		<div>your content</div>
		*@

		@foreach (var item in Model)
		{
			<div class="testimonials-swiper-element">
				<div class="text_testimonials-swiper_heading">

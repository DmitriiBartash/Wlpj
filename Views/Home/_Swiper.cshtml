@model LandingPage.Models.SwiperMiniModel;

<p hidden id="selectedCountry">@ViewBag.SelectedCountry</p>

<div class="InnerBlock">

	<div id="firstSwiperHolder">
		<partial name="_FirstSwiper" model="@Model" />
	</div>

	<div class="secondSwiper">
		@foreach (var countryName in Model.countriesData)
		{
			<p class="countryNames" name="@countryName.Value" >@countryName.Key</p>
		}
	</div>
</div>
@model LandingPage.Models.CallBackMiniModel;

<p id="Anchor3"></p>
<div id="callme" class="call-container">
	<div class="call-header-text">
		<h1> Хочу узнать поподробнее:</h1>
	</div>
	<form id="phoneForm">
		<div class="inputbox-container inputbox">
			<div class="inputbox-1">
				<input type="text" maxlength="40" class="inputbox1" id="name" />
				<label>Имя и фамилия</label>
			</div>
			<div class="inputbox-1">
				<input type="number" class="inputbox1" id="number" />
				<label>Телефон</label>
			</div>
			<div class="inputbox-2">
				<button class="btn-call" type="submit"><span>Перезвоните мне</span></button>
			</div>
			<div class="inputInformation"></div>
		</div>
	</form>
</div>
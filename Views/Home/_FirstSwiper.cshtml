<div class="firstSwiper">
	@foreach (var photo in Model.picturePathsChosen)
	{
		<img src="@photo">
	}
</div>

<div class="swiper-tagdescription">
	<div class="swiper-tagdescription-items">
		@if (@ViewBag.PriceIncludes == null)
		{
			<p>Цена включает:</p>
		}
		else
		{
			<p>@ViewBag.PriceIncludes</p>
		}
		<div class="tags">
			
			<div class="tags-text">
				@foreach (var tag in Model.tags)
				{
					<p><img src="~/content/tags/@tag.icon">@tag.tag</p>
				}
			</div>
		</div>


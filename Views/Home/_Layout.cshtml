<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width,initial-scale=1.0, maximum-scale=1.0" />
	<meta name="description" content="" />
	<title>@ViewData["Title"] - LandingPage</title>

	<link rel="stylesheet" href="~/css/Fonts.css" />
	<link rel="stylesheet" href="~/lib/slick/slickCDN.css" />

	<link rel="stylesheet" href="/css/bundledMain.css" />
</head>
<body>
	<partial name="_Header" />

	<section>
		<partial name="_Video" />
	</section>

	<section style="display: flex;flex-direction: column;justify-content: flex-start;">
		<p id="Anchor1"></p>
		<h2 class="hot-deals-header" id="hot_deals_h2">
			Горящие предложения
		</h2>
		<div class="hot-deals-container">
			<partial name="_Swiper" model="@ViewBag.SwiperViewModel" />
		</div>
	</section>

	<partial name="_AboutUs" />

	<section style="height: 100vh;display: flex;justify-content: center;align-items: center;align-content: center;">
		<partial name="_CallUs" />
	</section>

	<partial name="_Testimonials" model="@ViewBag.ReviewModel" />

	<section style="height: 100vh;display: flex;justify-content: center;align-items: center;align-content: center;">
		<partial name="_Map" />
	</section>

	<partial name="_Footer" />

	@RenderBody()

	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/slick/slick-min.js"></script>

	<script src="/js/bundledMain.js"></script>
</body>
</html>
